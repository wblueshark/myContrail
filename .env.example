# Contrail environment template.
# Copy to .env and fill in real values. .env is gitignored - never commit it.

# ── Runtime mode ──────────────────────────────────────────
CONTRAIL_MODE=local                  # local | cloud (MVP is local only)
CONTRAIL_ENABLE_AUTH=false
CONTRAIL_STORAGE_BACKEND=fs          # fs | s3 (s3 is reserved for cloud mode)

# ── Database ──────────────────────────────────────────────
# psycopg3 driver. The same URL serves Alembic (sync) and FastAPI (async).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/mycontrail

# ── Redis (ARQ task queue) ────────────────────────────────
# Local mode runs imports in-process and does not need the worker; Redis is for
# cloud mode and for background jobs identified by a storage key.
REDIS_URL=redis://localhost:6379/0

# ── Local data directory ──────────────────────────────────
# Thumbnails, retained source files, exports and the basemap tile cache.
CONTRAIL_DATA_DIR=./data

# NOTE: there is deliberately NO scan-root allowlist setting (removed in v2.3).
# The photo directory is chosen through the host's native folder picker and
# referenced by a one-shot pick_token that lives only in the API process's
# memory. No scan root is ever persisted, which is what turns "the original
# directory is read exactly once" from a promise into a structural guarantee:
# a background rescan has nothing to rescan. See docs/design/05-architecture
# section 3.1. If your .env still carries CONTRAIL_ALLOWED_SCAN_ROOTS it is
# ignored and can be deleted.

# ── Mapbox ────────────────────────────────────────────────
# https://account.mapbox.com/access-tokens/
# Frontend uses a public token (pk.*); add URL restrictions to it.
VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx
# Server-side PNG export (basemap tiles) and anchor reverse geocoding.
# May be the same token.
MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx

# ── Privacy ───────────────────────────────────────────────
# false = no reverse-geocoding request ever leaves this machine. Place names
# stay empty; the map and every spatial query still work.
CONTRAIL_GEOCODING_ENABLED=true

# ── Local security ────────────────────────────────────────
# Generated into ~/.contrail/token on first start if left empty.
# Binding to 127.0.0.1 is NOT sufficient on its own - all four guards matter:
#   this token          other processes on this machine calling the API
#   Host header check   DNS rebinding
#   CORS allowlist      which origins may read responses
#   X-Contrail-Client   CSRF on write requests
CONTRAIL_LOCAL_TOKEN=
CONTRAIL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTRAIL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],::1
